# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/frontend/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/frontend/coverage
/frontend/playwright-report
/frontend/test-results
/frontend/blob-report

# next.js
/frontend/.next/
/frontend/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
/logs


# env files (can opt-in for committing if needed)
.env*
!.env.example
!backend/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
frontend/next-env.d.ts
# Rails
backend/.bundle/
backend/log/*
backend/tmp/*
backend/storage/*
!backend/log/.keep
!backend/tmp/.keep

# Terraform（stateと実値入りtfvarsはコミットしない）
infra/.terraform/
infra/*.tfstate
infra/*.tfstate.*
infra/terraform.tfvars
